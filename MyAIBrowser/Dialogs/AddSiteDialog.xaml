<!-- 文件路径：MyAIBrowser/Dialogs/AddSiteDialog.xaml -->
<!-- 功能：添加 / 编辑站点对话框（无边框 + 阴影 + 白底） -->
<Window x:Class="MyAIBrowser.Dialogs.AddSiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加站点" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="{StaticResource AppFont}"
        Background="Transparent" ShowInTaskbar="False">
    <!-- 外层 Border：白色圆角卡片 + 阴影；Margin 给阴影留出渲染空间 -->
    <Border Background="White" CornerRadius="8" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Style="{StaticResource DialogHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource DialogTitleText}"/>
                    <Button Content="&#xE8BB;" Click="Cancel_Click" Width="34" Height="34"
                            HorizontalAlignment="Right" Style="{StaticResource WindowCloseButton}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,24" Background="White">
                <TextBlock Text="站点名称" FontSize="14" Foreground="{StaticResource TextSub}"/>
                <TextBox x:Name="NameBox" Height="36" Margin="0,6,0,14" FontSize="15"
                         VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource BorderLine}" Foreground="{StaticResource TextMain}"/>

                <TextBlock Text="网址 (URL)" FontSize="14" Foreground="{StaticResource TextSub}"/>
                <TextBox x:Name="UrlBox" Height="36" Margin="0,6,0,20" FontSize="15"
                         VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource BorderLine}" Foreground="{StaticResource TextMain}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click" Style="{StaticResource GhostButton}"/>
                    <Button Content="确定" Click="Ok_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
