<!-- 文件路径：MyAIBrowser/Dialogs/SettingsDialog.xaml -->
<!-- 功能：设置对话框（无边框 + 阴影 + 白底）：网络代理 + 下载目录 -->
<Window x:Class="MyAIBrowser.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="{StaticResource AppFont}"
        Background="Transparent" ShowInTaskbar="False">
    <!-- 外层 Border：白色圆角卡片 + 阴影；Margin 给阴影留出渲染空间 -->
    <Border Background="White" CornerRadius="8" Margin="14"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Border Grid.Row="0" Style="{StaticResource DialogHeader}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource DialogTitleText}"/>
                <Button Content="&#xE8BB;" Click="Cancel_Click" Width="34" Height="34"
                        HorizontalAlignment="Right" Style="{StaticResource WindowCloseButton}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20,24,24">
            <!-- 网络代理 -->
            <TextBlock Text="网络代理" FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}"/>
            <TextBlock Text="WebView2 有时不跟随系统代理，可在此显式指定代理地址。" FontSize="12"
                       Foreground="{StaticResource TextSub}" Margin="0,4,0,10" TextWrapping="Wrap"/>

            <RadioButton x:Name="ProxySystemRb" GroupName="ProxyMode" Content="跟随系统代理（自动读取）"
                         FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,4"/>
            <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                <RadioButton x:Name="ProxyManualRb" GroupName="ProxyMode" Content="手动代理："
                             FontSize="14" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                <TextBox x:Name="ProxyBox" Width="220" Height="32" Margin="6,0,0,0" FontSize="14"
                         VerticalContentAlignment="Center" Padding="6,0"
                         BorderBrush="{StaticResource BorderLine}" Foreground="{StaticResource TextMain}"
                         ToolTip="格式：127.0.0.1:7890"/>
            </StackPanel>
            <RadioButton x:Name="ProxyNoneRb" GroupName="ProxyMode" Content="禁用代理"
                         FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,6,0,0"/>

            <Separator Margin="0,16"/>

            <!-- 下载目录 -->
            <TextBlock Text="下载目录" FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DownloadFolderBox" Height="34" FontSize="14"
                         VerticalContentAlignment="Center" Padding="8,0"
                         BorderBrush="{StaticResource BorderLine}" Foreground="{StaticResource TextMain}"/>
                <Button Grid.Column="1" Content="浏览…" Click="BrowseFolder_Click"
                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="34"/>
            </Grid>

            <Separator Margin="0,16"/>

            <!-- 隐私与数据 -->
            <TextBlock Text="隐私与数据" FontSize="14.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMain}"/>
            <TextBlock Text="清除所有站点的 Cookie、缓存与登录状态（需重新登录）。" FontSize="12"
                       Foreground="{StaticResource TextSub}" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <Button Content="清除浏览数据…" Click="ClearData_Click"
                    Style="{StaticResource GhostButton}" Height="34" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Click="Cancel_Click" Style="{StaticResource GhostButton}"/>
                <Button Content="保存" Click="Ok_Click" Style="{StaticResource ActionButton}" Margin="10,0,0,0" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
