<!-- 文件路径：MyAIBrowser/MainWindow.xaml -->
<!-- 功能：主窗口布局（vivo 办公套件风格，浅色绿色主题）：
     标题栏 / 标签页栏 / 工具栏（导航+地址栏） / 左侧站点栏 + WebView2 内容区 / 下载状态栏 -->
<Window x:Class="MyAIBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MyAI Browser"
        Icon="pack://application:,,,/App.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource WindowBg}"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <!-- WindowChrome：真正的无边框窗口；GlassFrameThickness=1 让 DWM 绘制系统阴影 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>   <!-- 标题栏 -->
            <RowDefinition Height="36"/>   <!-- 标签页栏 -->
            <RowDefinition Height="44"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>    <!-- 内容区 -->
            <RowDefinition Height="Auto"/> <!-- 下载状态栏 -->
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBg}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Green600}" Margin="0,0,8,0"/>
                    <TextBlock Text="MyAI Browser" FontWeight="SemiBold" FontSize="14.5"
                               Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource WindowButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最小化"/>
                    <Button Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource WindowButton}" x:Name="MaximizeBtn"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="最大化"/>
                    <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource WindowCloseButton}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 标签页栏 ============ -->
        <Border Grid.Row="1" Background="{StaticResource TabBarBg}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1">
            <Grid>
                <ListBox x:Name="TabListBox"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Margin="40,0,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="TabListBox_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource BrowserTab}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="TabBorder"
                                                Background="Transparent"
                                                CornerRadius="8,8,0,0"
                                                BorderThickness="0,0,0,2"
                                                BorderBrush="Transparent"
                                                Padding="10,0,4,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverGray}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Green100}"/>
                                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Green600}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                           Foreground="{StaticResource TextMain}"
                                           MaxWidth="220" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="&#x2715;" Tag="{Binding}" Click="TabClose_Click"
                                        Width="20" Height="20"
                                        Foreground="{StaticResource TextSub}"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Margin="4,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                <TextBlock x:Name="Glyph" Text="&#xE8BB;" FontSize="9"
                                                           FontFamily="{StaticResource IconFont}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#B3201B"/>
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 新建标签按钮 -->
                <Button Content="&#xE710;" Click="NewTab_Click"
                        Width="32" Height="32" Margin="4,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource RoundIconButton}"
                        ToolTip="新建标签页 (Ctrl+T)"/>
            </Grid>
        </Border>

        <!-- ============ 工具栏：导航 + 地址栏 + 设置 ============ -->
        <Border Grid.Row="2" Background="{StaticResource TitleBarBg}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE72B;" Click="Back_Click" Style="{StaticResource RoundIconButton}" x:Name="BackBtn" ToolTip="后退"/>
                    <Button Content="&#xE72A;" Click="Forward_Click" Style="{StaticResource RoundIconButton}" x:Name="ForwardBtn" ToolTip="前进"/>
                    <Button Content="&#xE72C;" Click="Refresh_Click" Style="{StaticResource RoundIconButton}" x:Name="RefreshBtn" ToolTip="刷新"/>
                    <Button Content="&#xE80F;" Click="Home_Click" Style="{StaticResource RoundIconButton}" x:Name="HomeBtn" ToolTip="主页"/>
                </StackPanel>

                <!-- 地址栏 -->
                <Border Grid.Column="1" Background="#F2F3F5" CornerRadius="15"
                        BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                        Height="30" Margin="10,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AddressBar"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextMain}" FontSize="14"
                                 VerticalContentAlignment="Center" Padding="12,0"
                                 KeyDown="AddressBar_KeyDown"
                                 ToolTip="输入网址，回车打开"/>
                        <Button Grid.Column="1" Content="&#xE76C;" Click="AddressBar_Go"
                                Width="26" Height="26" Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource RoundIconButton}"
                                ToolTip="打开"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE713;" Click="Settings_Click"
                            Style="{StaticResource RoundIconButton}"
                            ToolTip="设置（代理 / 下载目录）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 内容区：左侧站点栏 + WebView2 ============ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧站点栏 -->
            <Border Grid.Column="0" Background="{StaticResource TitleBarBg}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AI 站点" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}" Margin="16,12,0,8"/>

                    <ListBox x:Name="SiteListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Sites}"
                             SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             MouseLeftButtonUp="SiteListBox_MouseLeftButtonUp"
                             ContextMenuOpening="SiteListBox_ContextMenuOpening">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SiteListItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="16"
                                           Foreground="{StaticResource TextMain}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" Click="SiteMenu_Open"/>
                                <MenuItem Header="在新标签页打开" Click="SiteMenu_OpenNewTab"/>
                                <Separator/>
                                <MenuItem Header="编辑…" Click="SiteMenu_Edit"/>
                                <MenuItem Header="删除" Click="SiteMenu_Delete"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="10,8">
                        <Button Content="&#xFF0B; 添加站点" Click="AddSite_Click"
                                Style="{StaticResource GreenHoverButton}" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 宿主（标签页控件动态加入） -->
            <Grid Grid.Column="1" x:Name="WebHostGrid" Background="White"
                  ClipToBounds="True"/>
        </Grid>

        <!-- ============ 下载状态栏 ============ -->
        <Border Grid.Row="4" x:Name="DownloadBar" Background="{StaticResource TabBarBg}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <ItemsControl x:Name="DownloadList" Margin="12,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                       Foreground="{StaticResource TextMain}" MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Width="120" Height="6" Margin="8,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding Percent, Mode=OneWay}"
                                         Foreground="{StaticResource Green600}"
                                         Background="#E8EAED"/>
                            <TextBlock Text="{Binding PercentText}" FontSize="11"
                                       Foreground="{StaticResource TextSub}" Width="34"/>
                            <Button Content="取消" FontSize="11" Height="20" Padding="8,0"
                                    Margin="4,0,0,0" Tag="{Binding}" Click="DownloadCancel_Click"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>
